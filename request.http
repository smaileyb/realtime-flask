@baseUrl = http://localhost:5000

### Create PIX payment
POST {{baseUrl}}/payments/pix
Content-Type: application/json

{
  "value": 12000
}

### Confirm PIX payment
POST {{baseUrl}}/payments/pix/confirmation
Content-Type: application/json

{
  "value": 12000,
  "bank_payment_id": "fdacca8a-4664-4af2-9bf9-4d519595b7c3"
}

### Get PIX payment
GET {{baseUrl}}/payments/pix/1
Accept: text/plain

### Get QR code image
GET {{baseUrl}}/payments/pix/qr_code/qr_code_payment_c5fb8b9f-af91-431a-be35-9f7461acc313